{
  "name": "kartplan-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:campaigns": "node scripts/sync-campaigns.mjs",
    "deploy": "npm run build && firebase deploy",
    "deploy:ci": "bash scripts/deploy.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "npx --yes firebase-tools@15.34.0 emulators:exec --only firestore --project demo-kartplan \"vitest run scripts/league-rules.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
